# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:4000"

# DATABASE_URL: SQLite file connection string (saves directly to folder).
# Format: sqlite://./server/data/sedona_pms.db
DATABASE_URL="sqlite://server/data/sedona_pms.db"

# API_PORT: Port for the Express backend server. Default is 4000.
API_PORT=4000

# JWT_SECRET: Required. Secret key for signing JWT authentication tokens.
# Generate a strong random value: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"
