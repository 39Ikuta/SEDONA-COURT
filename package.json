{
  "name": "sedona-court-pms",
  "private": true,
  "version": "1.0.0",
  "description": "Sedona Court Travellers Inn Property Management System",
  "author": "Sedona Court Travellers Inn",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js release",
    "lint": "tsc --noEmit",
    "server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "seed": "tsx --tsconfig tsconfig.server.json server/db/seed.ts",
    "migrate": "tsx --tsconfig tsconfig.server.json server/db/migration-runner.ts run",
    "migrate:status": "tsx --tsconfig tsconfig.server.json server/db/migration-runner.ts status",
    "migrate:create": "tsx --tsconfig tsconfig.server.json server/db/migration-runner.ts create",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "tsx --tsconfig tsconfig.server.json server/db/reset.ts",
    "dev:all": "concurrently --kill-others-on-fail -n server,frontend -c green,blue \"npm run server\" \"wait-on http://localhost:4000/api/health && npm run dev\"",
    "build:server": "esbuild server/index.ts --bundle --platform=node --outfile=dist-server/index.js --format=esm",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "npm run build:server && cross-env ELECTRON=true vite build && electron-builder",
    "electron:pack": "cross-env ELECTRON=true vite build && electron-builder --dir",
    "server:prod": "npx pm2 start ecosystem.config.cjs",
    "server:stop": "npx pm2 stop sedona-api",
    "server:logs": "npx pm2 logs sedona-api",
    "tunnel": "ngrok http --domain=doretta-unordained-josiah.ngrok-free.dev 3000",
    "dev:tunnel": "concurrently \"npm run dev\" \"npm run server\" \"npm run tunnel\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/socket.io": "^3.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^8.0.0"
  }
}
